{
  "name": "ui-design-judgment",
  "version": "0.1.0",
  "description": "Contextual UI design judgment with scoped rendered evidence for AI agents",
  "private": true,
  "packageManager": "bun@1.4.1",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "scripts": {
    "lint": "eslint skills/ui-design-judgment/scripts scripts tests",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check-package.mjs",
    "inspect": "node skills/ui-design-judgment/scripts/cli.mjs inspect",
    "validate-report": "node skills/ui-design-judgment/scripts/cli.mjs validate",
    "test:browser": "playwright test",
    "test:shadcn": "node --test tests/shadcn.test.mjs"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "ajv": "^8.20.0"
  },
  "devDependencies": {
    "@shadcn/lint": "^0.2.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "typescript-eslint": "^8.71.1"
  }
}
