{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "build", "mode", "evaluator", "intent", "scope", "coverage", "checks", "evidence", "assessment", "findings", "limits"],
  "properties": {
    "schemaVersion": {"const": 1}, "build": {"$ref": "#/definitions/text"},
    "mode": {"enum": ["build", "review", "refine"]}, "evaluator": {"$ref": "#/definitions/text"},
    "intent": {"type": "object", "additionalProperties": false, "required": ["audience", "task", "primaryFocus", "designSystem", "assumptions"], "properties": {"audience": {"$ref": "#/definitions/text"}, "task": {"$ref": "#/definitions/text"}, "primaryFocus": {"$ref": "#/definitions/text"}, "designSystem": {"$ref": "#/definitions/text"}, "assumptions": {"$ref": "#/definitions/strings"}}},
    "scope": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "route", "viewport", "state"], "properties": {"id": {"$ref": "#/definitions/text"}, "route": {"$ref": "#/definitions/text"}, "viewport": {"$ref": "#/definitions/text"}, "state": {"$ref": "#/definitions/text"}}}},
    "coverage": {"type": "object", "additionalProperties": false, "required": ["inspected", "missing"], "properties": {"inspected": {"$ref": "#/definitions/strings"}, "missing": {"$ref": "#/definitions/strings"}}},
    "checks": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "dimension", "status", "required", "surfaces", "evidence", "reason"], "properties": {"id": {"$ref": "#/definitions/text"}, "dimension": {"enum": ["correctness", "coherence"]}, "status": {"enum": ["pass", "fail", "unavailable", "not-applicable"]}, "required": {"type": "boolean"}, "surfaces": {"$ref": "#/definitions/strings"}, "evidence": {"$ref": "#/definitions/strings"}, "reason": {"$ref": "#/definitions/text"}}}},
    "evidence": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "path", "kind", "sha256"], "properties": {"id": {"$ref": "#/definitions/text"}, "path": {"$ref": "#/definitions/text"}, "kind": {"enum": ["screenshot", "trace", "checks", "source", "other"]}, "surface": {"$ref": "#/definitions/text"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}},
    "assessment": {"type": "object", "additionalProperties": false, "required": ["correctness", "coherence", "taste"], "properties": {"correctness": {"$ref": "#/definitions/assessment"}, "coherence": {"$ref": "#/definitions/assessment"}, "taste": {"type": "object", "additionalProperties": false, "required": ["status", "rationale", "evidence"], "properties": {"status": {"enum": ["acceptable", "needs-refinement", "unreviewed"]}, "rationale": {"$ref": "#/definitions/text"}, "evidence": {"$ref": "#/definitions/strings"}}}}},
    "findings": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "nature", "dimension", "severity", "surface", "observation", "consequence", "recommendation", "verification", "evidence"], "properties": {"id": {"$ref": "#/definitions/text"}, "nature": {"enum": ["measured", "judgment"]}, "dimension": {"enum": ["correctness", "coherence", "taste"]}, "severity": {"enum": ["blocker", "advisory"]}, "surface": {"$ref": "#/definitions/text"}, "observation": {"$ref": "#/definitions/text"}, "consequence": {"$ref": "#/definitions/text"}, "recommendation": {"$ref": "#/definitions/text"}, "verification": {"$ref": "#/definitions/text"}, "evidence": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/definitions/text"}}}}},
    "limits": {"$ref": "#/definitions/strings"}
  },
  "definitions": {
    "text": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "strings": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/definitions/text"}},
    "assessment": {"type": "object", "additionalProperties": false, "required": ["status", "rationale", "evidence"], "properties": {"status": {"enum": ["pass", "fail", "unverified"]}, "rationale": {"$ref": "#/definitions/text"}, "evidence": {"$ref": "#/definitions/strings"}}}
  }
}
